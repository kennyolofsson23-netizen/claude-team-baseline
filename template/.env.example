# Copy to .env and fill in real values. Never commit .env.
# Missing required values will prevent the app from starting.

# --- Application ---
APP_NAME=project-name-here
APP_ENV=local            # local | dev | staging | prod
LOG_LEVEL=INFO

# --- Database (Microsoft SQL Server) ---
# SQLAlchemy URL format:
#   mssql+pyodbc://<user>:<password>@<host>:1433/<database>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
APP_DB_URL=

# --- Deployment (used by deployer agent) ---
# DEPLOY_REGISTRY=<registry.company.internal>
# DEPLOY_TARGET_APP_NAME=
# DEPLOY_TARGET_RG=
